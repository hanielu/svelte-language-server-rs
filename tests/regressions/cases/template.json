  "Card.svelte": "<script lang=\"ts\">\n\timport Child from \"./Child.svelte\";\n\ttype Size = \"sm\" | \"lg\";\n\ttype Row = { id: string; size: Size };\n\tlet rows: Row[] = $state([]);\n\tlet val: Size = $state(\"sm\");\n\tlet tag = \"div\";\n\tfunction act(node: HTMLElement, p: Size) { return {}; }\n\tconst prom: Promise<Size> = Promise.resolve(\"sm\");\n</script>\n{#each rows as row (row.id)}<p class:big={row.size === val}>{row.id}</p>{/each}\n{#each rows as { id, size } (id)}<p style:width={size}>{id}</p>{/each}\n{#snippet cell(x: Size, r: Row)}<td use:act={x}>{r.id}{x}</td>{/snippet}\n{#snippet inner(y: Size)}{@const z: Size = y}<b>{z}</b>{/snippet}\n{@render cell(val, rows[0])}\n{#await prom then v}<i>{v}{val}</i>{/await}\n<svelte:element this={tag} title={val}>{val}</svelte:element>\n<input bind:value={val} />\n<Child size={val}>{#snippet named(q: Size)}{q}{/snippet}</Child>\n<div>{@render inner(val)}</div>\n",
